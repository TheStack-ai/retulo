{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:retulo:task:2",
  "title": "Retulo task state v2",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "title",
    "goal",
    "status",
    "mode",
    "completion_criteria",
    "artifacts",
    "sources",
    "decisions",
    "bindings",
    "operations",
    "workflow",
    "workflow_history",
    "input_bindings",
    "runs",
    "active_outputs",
    "current_deliverable_set"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "mode": {
      "enum": [
        "light",
        "expanded"
      ]
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "sources": {
      "type": "array"
    },
    "artifacts": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    },
    "bindings": {
      "type": "array"
    },
    "operations": {
      "type": "object"
    },
    "criteria_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion_result"
      }
    },
    "criteria_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recorded_at",
          "revision",
          "result"
        ],
        "properties": {
          "recorded_at": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "$ref": "#/$defs/criterion_result"
          },
          "kind": {
            "const": "legacy_snapshot"
          },
          "recorded_at_status": {
            "const": "unknown"
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "observed_at",
                "recorded_at_status"
              ],
              "properties": {
                "recorded_at": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "recorded_at": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "attention": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/attention"
        }
      ]
    },
    "workflow": {
      "type": "object",
      "required": [
        "definition",
        "revision",
        "generation",
        "digest",
        "parameters",
        "environment"
      ],
      "properties": {
        "definition": {
          "type": "object"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parameters": {
          "type": "object"
        },
        "environment": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "workflow_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ref",
          "mode",
          "binding_revision",
          "bound_at"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^source:"
          },
          "mode": {
            "enum": [
              "follow",
              "pinned"
            ]
          },
          "binding_revision": {
            "type": "integer",
            "minimum": 1
          },
          "bound_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "step_id",
          "step_digest",
          "signature",
          "resolved_inputs",
          "parameters",
          "environment",
          "outputs",
          "checks",
          "status",
          "started_at",
          "dependency_coverage",
          "claim_origin",
          "generation"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "step_digest": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "resolved_inputs": {
            "type": "object"
          },
          "parameters": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object"
          },
          "status": {
            "enum": [
              "started",
              "succeeded",
              "failed",
              "interrupted",
              "stale"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "dependency_coverage": {
            "enum": [
              "declared_complete",
              "partial",
              "unknown"
            ]
          },
          "claim_origin": {
            "const": "caller_reported"
          }
        }
      }
    },
    "active_outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "run_id",
          "outputs"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "current_deliverable_set": {
      "type": [
        "object",
        "null"
      ]
    },
    "recipe_binding": {
      "type": "object",
      "required": [
        "recipe_id",
        "revision",
        "sha256",
        "semantic_digest",
        "origin_task_id",
        "artifact_ref",
        "manifest"
      ],
      "properties": {
        "recipe_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string"
        },
        "semantic_digest": {
          "type": "string"
        },
        "origin_task_id": {
          "type": "string"
        },
        "artifact_ref": {
          "type": "string"
        },
        "manifest": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "requires_approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requires_approval": {
          "type": "boolean"
        },
        "approval_scope": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "human_review": {
          "type": "string",
          "minLength": 1
        },
        "requires_independent_review": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "human_review"
            ]
          },
          "then": {
            "properties": {
              "requires_approval": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "self",
            "automated",
            "independent"
          ]
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1
        },
        "execution_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "independent"
              }
            }
          },
          "then": {
            "required": [
              "reviewer_ref",
              "execution_ref"
            ]
          }
        }
      ]
    },
    "criterion_result": {
      "type": "object",
      "required": [
        "criterion",
        "status"
      ],
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "claim_origin": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "attention": {
      "type": "object",
      "required": [
        "kind",
        "owner",
        "reason",
        "requested_action"
      ],
      "properties": {
        "kind": {
          "enum": [
            "question",
            "review",
            "blocked"
          ]
        },
        "owner": {
          "enum": [
            "user",
            "agent",
            "external"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requested_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
