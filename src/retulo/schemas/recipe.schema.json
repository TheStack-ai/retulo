{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:retulo:recipe:1",
  "title": "Retulo recipe manifest v1",
  "description": "A bounded workflow contract. Origin and qualification are unverified references, not execution permission, successful results, or human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe_schema_version", "recipe_id", "revision", "title", "workflow"],
  "properties": {
    "recipe_schema_version": {"const": 1},
    "recipe_id": {"$ref": "#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 8000},
    "workflow": {"$ref": "urn:retulo:workflow:1"},
    "completion_criteria": {
      "type": ["array", "null"],
      "maxItems": 100,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "origin": {"$ref": "#/$defs/origin"},
    "qualification": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/qualification"}
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"}
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "run_ids": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "workflow_digest", "run_ids"],
      "properties": {
        "task_id": {"$ref": "#/$defs/uuid"},
        "workflow_revision": {"type": "integer", "minimum": 1},
        "workflow_digest": {"$ref": "#/$defs/sha256"},
        "run_ids": {"$ref": "#/$defs/run_ids"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "task_id", "workflow_digest", "run_ids"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"},
        "task_id": {"$ref": "#/$defs/uuid"},
        "workflow_revision": {"type": "integer", "minimum": 1},
        "workflow_digest": {"$ref": "#/$defs/sha256"},
        "run_ids": {"$ref": "#/$defs/run_ids"},
        "note": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
      }
    },
    "criterion": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"},
            "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
            "requires_approval": {"type": "boolean"},
            "approval_scope": {"type": ["string", "null"], "minLength": 1, "maxLength": 100, "pattern": "\\S"},
            "basis": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
            "human_review": {
              "oneOf": [
                {"const": false},
                {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"}
              ]
            },
            "requires_independent_review": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {"required": ["human_review"], "properties": {"human_review": {"type": "string"}}},
              "then": {"properties": {"requires_approval": {"const": true}}}
            },
            {
              "if": {"required": ["approval_scope"], "properties": {"approval_scope": {"type": "string"}}},
              "then": {
                "anyOf": [
                  {"required": ["requires_approval"], "properties": {"requires_approval": {"const": true}}},
                  {"required": ["human_review"], "properties": {"human_review": {"type": "string"}}}
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
